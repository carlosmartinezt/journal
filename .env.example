# Journal — environment configuration.
# Copy to `.env` and fill in your Supabase project values.
# Only PUBLIC values belong here — never the service role or DB password.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable / anon key (safe to expose to the browser).
# Dashboard → Project Settings → API → Project API keys → anon/publishable.
VITE_SUPABASE_ANON_KEY=

# Shown on the Settings screen. Optional.
VITE_APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# The following are used ONLY by local admin scripts (migrations / test user),
# never by the app bundle. Keep them secret; do not put them in Vite vars.
#
#   DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<ref>.supabase.co:5432/postgres
#   PGSSLROOTCERT=./scripts/.supabase-ca.pem   # pinned Supabase CA for TLS verify
# ---------------------------------------------------------------------------
